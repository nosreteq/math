[Unit]
Description=Matematica do Zero - API de progresso
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/math/server
EnvironmentFile=/home/ubuntu/math/server/.env
ExecStart=/home/ubuntu/math/server/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
