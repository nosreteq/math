# Copie para .env e ajuste antes de subir o serviço.

# Domínio(s) que podem chamar a API (separados por vírgula, sem barra no final)
MD0_ALLOWED_ORIGINS=https://nosreteq.github.io

# Caminho do arquivo SQLite (opcional, padrão: server/math.db)
MD0_DB_PATH=/home/ubuntu/math/server/math.db

# Chave usada para assinar os tokens de login. OBRIGATÓRIA.
# Gere uma só vez com: python3 -c "import secrets; print(secrets.token_hex(32))"
# Se trocar depois, todos os alunos logados são deslogados (precisam logar de novo).
MD0_JWT_SECRET=
